# Public site URL used for canonical tags, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://volkswagenbhubaneswaroffers.in

# Google Analytics 4 measurement ID (example: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Ads conversion tracking (example: AW-123456789 and label abcDEFghi)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Meta (Facebook) Pixel ID, optional
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console verification token, optional
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server side lead delivery. Any endpoint that accepts a JSON POST
# (Google Apps Script web app, Zapier, Make, n8n, your CRM webhook).
LEAD_WEBHOOK_URL=

# Optional shared secret sent as x-webhook-token header with each lead
LEAD_WEBHOOK_TOKEN=
